{
  "mcpServers": {
      "playwright": {
        "type": "stdio",
        "command": "cmd",
        "args": [
          "/c",
          "npx",
          "-y",
          "@playwright/mcp@latest",
          "--isolated"
        ]
      },
    "chrome-devtools": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    }
  }
}